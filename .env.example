# Cloudinary — nombre del cloud (ver Cloudinary Dashboard → Product Environment Credentials)
VITE_CLOUDINARY_CLOUD_NAME=

# Endpoint del formulario de contacto (ej. Formspree, un backend propio, etc.)
# Mientras esté vacío, el formulario de Contacto informa que aún no está conectado.
VITE_CONTACT_FORM_ENDPOINT=

# URL pública del sitio, una vez desplegado (ej. https://fulgor-restaurativo.vercel.app
# o un dominio propio). Se usa para el <link rel="canonical"> y las etiquetas Open Graph.
VITE_SITE_URL=
