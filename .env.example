# CLOUDINARY — https://cloudinary.com/console
# Cloud name: se usa en el navegador (VITE_) para construir las URLs de imagen.
VITE_CLOUDINARY_CLOUD_NAME=

# API Key/Secret: SOLO para scripts/upload-fotos-fulgor.js (Node, nunca se
# exponen al navegador — por eso NO llevan el prefijo VITE_).
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# FORMULARIO DE CONTACTO
# Endpoint genérico que usa hoy ContactForm.jsx (Formspree, backend propio, etc.).
# Mientras esté vacío, el formulario informa que aún no está conectado.
VITE_CONTACT_FORM_ENDPOINT=

# Alternativa EmailJS — documentada para cuando se decida usarla; ContactForm.jsx
# todavía NO está integrado con EmailJS, solo usa VITE_CONTACT_FORM_ENDPOINT arriba.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# URL pública del sitio, una vez desplegado (ej. https://fulgor-restaurativo.vercel.app
# o un dominio propio). Se usa para el <link rel="canonical"> y las etiquetas Open Graph.
VITE_SITE_URL=
